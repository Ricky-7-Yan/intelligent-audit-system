# Web
WEB_HOST=127.0.0.1
WEB_PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security. Keep local for a single-user desktop. Shared deployments must use enforced.
SECURITY_MODE=local
DEFAULT_TENANT_ID=local
DEFAULT_SUBJECT=local-admin
TENANT_ISOLATION=True
API_RATE_LIMIT_PER_MINUTE=180
# JSON object keyed by bearer token. Inject through a secret manager; never commit real values.
AUDITPILOT_API_TOKENS_JSON=
AUDIT_LOG_SIGNING_KEY=

# LLM provider. Leave API keys empty to run in deterministic fallback mode.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional OpenAI-compatible overrides
LLM_BASE_URL=
LLM_MODEL=
# Legacy Qwen-compatible variables remain supported.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo
MAX_TOKENS=2048
TEMPERATURE=0.2
TOP_P=0.9

# Optional MySQL audit standards database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=audit_system
MYSQL_CONNECT_TIMEOUT=3

# Optional Neo4j knowledge graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_CONNECT_TIMEOUT=3

# RAG
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_ENABLE_TFIDF=True
RAG_ENABLE_EMBEDDINGS=False

# Upload governance
KNOWLEDGE_UPLOAD_MAX_BYTES=5242880
EVIDENCE_UPLOAD_MAX_BYTES=5242880
UPLOAD_CHUNK_BYTES=65536
REJECT_PROMPT_INJECTION=True
