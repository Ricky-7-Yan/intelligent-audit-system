# Web
WEB_HOST=0.0.0.0
WEB_PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# LLM provider. Leave QWEN_API_KEY empty to run in deterministic fallback mode.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo
MAX_TOKENS=2048
TEMPERATURE=0.2
TOP_P=0.9

# Optional MySQL audit standards database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=audit_system
MYSQL_CONNECT_TIMEOUT=3

# Optional Neo4j knowledge graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_CONNECT_TIMEOUT=3

# RAG
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
